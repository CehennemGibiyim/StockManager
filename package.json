{
  "name": "stockmanager",
  "version": "1.1.0",
  "private": true,
  "description": "StockManager - ürün, stok, hareket, alım ve rapor yönetim paneli.",
  "author": "CehennemGibiyim",
  "license": "MIT",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build:js": "tsc -p tsconfig.build.json && node -e \"require('fs').copyFileSync('.tsbuild/main.js','main.js')\"",
    "icon": "node scripts/gen-icon.mjs",
    "build:web": "npm run build:js && node scripts/build-web.mjs",
    "build": "npm run build:web",
    "preview": "vite preview",
    "start:desktop": "npm run build:web && electron .",
    "dist:win": "npm run build:web && electron-builder --win nsis --publish never",
    "release": "node scripts/release.mjs",
    "release:same": "node scripts/release.mjs --same-version"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "lucide": "^1.68.0",
    "png-to-ico": "^3.0.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.5"
  },
  "build": {
    "appId": "com.cehennemgibiyim.stockmanager",
    "productName": "StockManager",
    "copyright": "Copyright © 2026 CehennemGibiyim",
    "directories": {
      "output": "release",
      "buildResources": "assets/brand"
    },
    "files": [
      "dist/web/**/*",
      "electron/**/*",
      "assets/brand/icon.png",
      "package.json"
    ],
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/brand/icon.ico",
      "artifactName": "StockManager-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "StockManager",
      "installerIcon": "assets/brand/icon.ico",
      "uninstallerIcon": "assets/brand/icon.ico",
      "installerHeaderIcon": "assets/brand/icon.ico",
      "deleteAppDataOnUninstall": false
    }
  }
}
